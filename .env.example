# Copy to .env and adjust; docker compose reads it automatically.

# Host port to publish the app on (container always listens on 5005).
HOST_PORT=5005

# BioGRID API key. Leave empty to run on SIGNOR + STRING only.
BIOGRID_KEY=

# Analysis limits
NW_MAX_GENES=30
NW_DISEASE_TOP_N=100
NW_PPI_TOP_N=30
NW_MAX_WORKERS=5

# Server sizing
GUNICORN_WORKERS=2
GUNICORN_THREADS=8
LOG_LEVEL=info
