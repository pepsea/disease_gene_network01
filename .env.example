# Copy to .env and adjust; docker compose reads it automatically.

# Host port to publish the app on (container always listens on 5005).
HOST_PORT=5005

# BioGRID API key. Leave empty to run on SIGNOR + STRING only.
BIOGRID_KEY=

# Analysis limits
NW_MAX_GENES=30
NW_DISEASE_TOP_N=100
NW_MAX_WORKERS=5

# PPI defaults (also settable per request from the UI)
NW_STRING_SCORE=700
NW_HUB_THRESHOLD=500
NW_MAX_NODES=1000

# Enrichment (2つ目の表)
NW_ENRICH_GENE_N=100
NW_ENRICH_MAX_TERMS=50

# 症状由来遺伝子 (3つ目の表)
NW_SYMPTOM_LIST_N=50
NW_SYMPTOM_MAX=20
NW_SYMPTOM_GENES_PER=50
# auto = Open Targets優先・HPOで補完 / opentargets / hpo
NW_SYMPTOM_SOURCE=auto
# 有意性検定の背景遺伝子数
NW_SYMPTOM_BACKGROUND=20000

# Server sizing
GUNICORN_WORKERS=2
GUNICORN_THREADS=8
LOG_LEVEL=info
